<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.batuhan.karnegonderici.scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Applications/Karne Gonderici.app/Contents/Resources/electron/launchAgent.cjs</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/karne_gonderici_scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/karne_gonderici_scheduler_err.log</string>
</dict>
</plist>
